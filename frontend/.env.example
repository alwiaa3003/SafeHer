# Build-time settings for the SafeHer frontend. Copy to .env.production.local (Git-ignored) and fill in.
# API origin. Leave empty when the API is served from the same origin under /api.
VITE_API_BASE_URL=
# Base-map tiles. Empty uses the public OpenStreetMap tile server, which is best-effort with no
# service guarantee. A public deployment should name a provider whose terms cover its traffic,
# or a self-hosted tile server. Some providers need an API key in the URL: never commit it.
VITE_TILE_URL=
# Required with a custom provider: its credit, plus OpenStreetMap's when the tiles use OSM data.
VITE_TILE_ATTRIBUTION=
VITE_TILE_MAX_ZOOM=19
