{
  "name": "safeher-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node src/seed/seed.js",
    "geo:fetch": "node scripts/fetch-delhi-boundary.js",
    "geo:import": "node src/seed/geography.js",
    "import:police-districts": "node src/seed/policeDistricts.js",
    "import:police-districts:check": "node src/seed/policeDistricts.js --check",
    "import:police-districts:dry-run": "node src/seed/policeDistricts.js --dry-run",
    "import:police-districts:verify": "node src/seed/policeDistricts.js --verify",
    "migrate:sources": "node scripts/migrate-source-metadata.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
