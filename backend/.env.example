# Copy this file to .env. Do not commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
PORT=4000
# Exact frontend origins, comma-separated. No "*". In production: https origins only.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
NODE_ENV=development
# Reverse-proxy hops in front of the API (often 1 on a hosting platform; 0 locally).
TRUST_PROXY=0
# Per-client limits: all routes per 15 minutes, and place searches per minute.
RATE_LIMIT_API=600
RATE_LIMIT_PLACES=20
# Place search provider (Nominatim usage policy applies to the public server).
GEOCODER_URL=https://nominatim.openstreetmap.org
# Optional: your own contact URL or email, sent in the User-Agent.
GEOCODER_CONTACT=
# Development only (npm run dev:memory): path to the Git-ignored GSDL review copy. Leave unset
# everywhere else. With NODE_ENV=production the server refuses to start if this is set.
# SAFEHER_REVIEW_DISTRICT_BOUNDARIES=
